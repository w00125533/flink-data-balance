FDB_DEPLOY_TARGET=local
SHARED_INFRA_DIR=../shared-data-infra

FDB_KAFKA_BOOTSTRAP=kafka:9092
FDB_KAFKA_INTERNAL_BOOTSTRAP=kafka:9092
FDB_KAFKA_HOST_BOOTSTRAP=localhost:9092

FDB_HDFS_URI=hdfs://namenode:8020

FDB_ICEBERG_ENABLED=true
FDB_ICEBERG_WAREHOUSE=hdfs://namenode:8020/warehouse/iceberg
FDB_ICEBERG_WAREHOUSE_PATH=/warehouse/iceberg
FDB_ICEBERG_CATALOG=fdb_iceberg
FDB_ICEBERG_DATABASE=fdb
FDB_ICEBERG_TABLE=cell_kpi

FDB_FLINK_JOB_JAR=/opt/fdb/flink-job-0.1.0-SNAPSHOT.jar
FDB_FLINK_CHECKPOINT_DIR=file:///tmp/fdb-checkpoints
FDB_FLINK_CHECKPOINT_INTERVAL_MS=10000
FDB_FLINK_PARALLELISM=4
FDB_METRICS_TOPIC=fdb-stage-metrics
FDB_E2E_SUMMARY=0
