FDB_DEPLOY_TARGET=local
SHARED_INFRA_DIR=../shared-data-infra

FDB_KAFKA_BOOTSTRAP=kafka:9092
FDB_KAFKA_INTERNAL_BOOTSTRAP=kafka:9092
FDB_KAFKA_HOST_BOOTSTRAP=localhost:9092

FDB_HDFS_URI=hdfs://namenode:8020

FDB_STARROCKS_FE_ENDPOINT=starrocks-fe:9030
FDB_STARROCKS_JDBC_URL=jdbc:mysql://starrocks-fe:9030/fdb?rewriteBatchedStatements=true&useServerPrepStmts=false
FDB_STARROCKS_USER=root
FDB_STARROCKS_PASSWORD=
FDB_STARROCKS_DATABASE=fdb
FDB_STARROCKS_JDBC_BATCH_SIZE=100000
FDB_STARROCKS_JDBC_BATCH_INTERVAL_MS=60000
FDB_STARROCKS_JDBC_MAX_RETRIES=1

FDB_ICEBERG_ENABLED=true
FDB_ICEBERG_WAREHOUSE=hdfs://namenode:8020/warehouse/iceberg
FDB_ICEBERG_WAREHOUSE_PATH=/warehouse/iceberg
FDB_ICEBERG_CATALOG=fdb_iceberg
FDB_ICEBERG_DATABASE=iceberg_db
FDB_ICEBERG_TABLE=cell_kpi
FDB_ICEBERG_METASTORE_URI=thrift://hive-metastore:9083

FDB_FLINK_JOB_JAR=/opt/fdb/flink-job-0.1.0-SNAPSHOT.jar
FDB_FLINK_CHECKPOINT_DIR=file:///tmp/fdb-checkpoints
FDB_FLINK_CHECKPOINT_INTERVAL_MS=30000
FDB_FLINK_PARALLELISM=4
FDB_FLINK_JOBMANAGER_MEMORY=1600m
FDB_FLINK_TASKMANAGER_MEMORY=4096m
FDB_FLINK_TASKMANAGER_SLOTS=4
FDB_FLINK_RETAINED_CHECKPOINTS=2

FDB_RESULT_SINK=starrocks
FDB_DLQ_ENABLED=true
FDB_METRICS_ENABLED=true
FDB_METRICS_TOPIC=fdb-stage-metrics
FDB_METRICS_EMIT_INTERVAL_MS=5000
FDB_METRICS_HISTORY_ENABLED=true
FDB_RUN_ID=
FDB_RUN_LABEL=
FDB_REPORT_ON_STOP=false
FDB_OBSERVABILITY_API_URL=http://localhost:18080
FDB_E2E_SUMMARY=0

FDB_FILE_SINK_ROLLOVER_INTERVAL_MS=600000
FDB_FILE_SINK_INACTIVITY_INTERVAL_MS=300000
FDB_FILE_SINK_MAX_PART_SIZE_BYTES=134217728

FDB_PROMETHEUS_URL=http://localhost:19090
FDB_PROMETHEUS_PORT=19090

FDB_KAFKA_SEGMENT_MS=600000
FDB_CHR_RETENTION_MS=3600000
FDB_PM_RETENTION_MS=3600000
FDB_ANOMALY_RETENTION_MS=3600000
FDB_KPI_1M_RETENTION_MS=3600000
FDB_KPI_5M_RETENTION_MS=3600000
FDB_METRICS_RETENTION_MS=3600000
FDB_STARROCKS_KPI_RETENTION_MS=3600000
FDB_STARROCKS_ANOMALY_RETENTION_MS=3600000
FDB_HDFS_KPI_RETENTION_MS=86400000
FDB_HDFS_INPROGRESS_RETENTION_MS=86400000
FDB_ICEBERG_FILE_RETENTION_MS=86400000
FDB_ICEBERG_INPROGRESS_RETENTION_MS=86400000
