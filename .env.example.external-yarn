FDB_DEPLOY_TARGET=external-yarn

JAVA_HOME=/usr/lib/jvm/java-17
FLINK_HOME=/opt/flink-1.20.3
HADOOP_CONF_DIR=/etc/hadoop/conf
YARN_CONF_DIR=/etc/hadoop/conf
HIVE_CONF_DIR=/etc/hive/conf

FDB_KAFKA_BOOTSTRAP=kafka01:9092,kafka02:9092
FDB_KAFKA_REPLICATION_FACTOR=1

FDB_HDFS_URI=hdfs://nameservice1
FDB_HIVE_JDBC_URL=jdbc:hive2://hive01:10000/default
FDB_HIVE_METASTORE_URI=thrift://hms01:9083
FDB_HIVE_WAREHOUSE=hdfs://nameservice1/warehouse/fdb
FDB_HIVE_WAREHOUSE_PATH=/warehouse/fdb/cell_kpi
FDB_HIVE_WAREHOUSE_ROOT=/warehouse/fdb

FDB_MYSQL_HOST=mysql01
FDB_MYSQL_PORT=3306
FDB_MYSQL_DATABASE=fdb
FDB_MYSQL_URL=jdbc:mysql://mysql01:3306/fdb
FDB_MYSQL_USER=fdb
FDB_MYSQL_PASSWORD=fdbpwd

FDB_ICEBERG_ENABLED=true
FDB_ICEBERG_WAREHOUSE=hdfs://nameservice1/warehouse/iceberg
FDB_ICEBERG_WAREHOUSE_PATH=/warehouse/iceberg
FDB_ICEBERG_CATALOG=fdb_iceberg
FDB_ICEBERG_DATABASE=fdb
FDB_ICEBERG_TABLE=cell_kpi

FDB_STARROCKS_FE_ENDPOINT=starrocks-fe01:9030
FDB_STARROCKS_USER=root
FDB_STARROCKS_PASSWORD=
FDB_STARROCKS_DATABASE=fdb

FDB_FLINK_TARGET=yarn-application
FDB_FLINK_YARN_QUEUE=default
FDB_FLINK_PARALLELISM=4
FDB_FLINK_CHECKPOINT_DIR=hdfs://nameservice1/flink-data-balance/checkpoints
FDB_FLINK_CHECKPOINT_PATH=/flink-data-balance/checkpoints
FDB_FLINK_CHECKPOINT_INTERVAL_MS=10000
FDB_FLINK_JOB_LOCAL_JAR=flink-job/target/flink-job-0.1.0-SNAPSHOT.jar
FDB_FLINK_EXTRA_ARGS=
FDB_FLINK_EXTRA_ARGS_FILE=
FDB_FLINK_CANCEL_ARGS_FILE=
FDB_METRICS_TOPIC=fdb-stage-metrics

FDB_EXTERNAL_STATE_FILE=logs/external-yarn-current.env
FDB_EXTERNAL_SUBMIT_LOG=logs-external-yarn-submit.out
FDB_EXTERNAL_SMOKE_SUBMIT=0

# FDB_MYSQL_PASSWORD is used by check/init on the deployment host.
# It is not propagated into YARN containers by default to avoid exposing it in
# process listings and YARN metadata. Prefer cluster-side secret injection.
# If that is not available and the exposure is acceptable, explicitly opt in:
# FDB_FLINK_SECRET_ENV_KEYS=FDB_MYSQL_PASSWORD
